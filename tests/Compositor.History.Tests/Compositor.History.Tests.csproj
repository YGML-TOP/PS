<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Compositor.History.Tests</RootNamespace>
    <AssemblyName>Compositor.History.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- 🔴 理由与 Compositor.Core.Tests 完全一致：测试程序集不需要产出 XML 文档，
         每个 [Fact] 都写 /// 是噪音；且 CS1591 会被 TreatWarningsAsErrors 升级为错误。 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Compositor.History\Compositor.History.csproj" />
    <ProjectReference Include="..\..\src\Compositor.Core\Compositor.Core.csproj" />
  </ItemGroup>

</Project>
