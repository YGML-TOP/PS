<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Compositor.App.App"
             RequestedThemeVariant="Dark">

  <!-- Fluent 是 Avalonia 官方主题里唯一随发行版一起提供的（Default/Light/Simple 都不是）。
       不加载它的话 Avalonia 会抛 "Could not find default style for Control"，窗口直接起不来。 -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

</Application>