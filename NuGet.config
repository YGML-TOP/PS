<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    <clear/> 必须放在最前面：本机 %APPDATA%\NuGet\NuGet.Config 的 <packageSources> 是空的，
    会让 restore 报 NU1100「找不到任何源」，即使网络正常。
    <clear/> 丢弃继承来的全部源，只保留本仓库显式声明的源。

    这是构建基础设施，不是业务代码：缺了它 src/ 与 tests/ 下所有工程都无法还原。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>