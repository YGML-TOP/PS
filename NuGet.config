<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    总管补：仓库原先没有任何 NuGet 源配置，`dotnet restore` 对 xunit 等测试包
    一律报 NU1100（无法解析）。本文件只声明公共源，不含任何凭据。
    由 mavis（总管）补入，属共享构建基础设施，不是业务代码。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>